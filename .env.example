# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=

# Telegram ID владельца бота (числовой), получает уведомления и доступ к админ-командам
OWNER_ID=

# Путь к файлу базы данных SQLite
DB_PATH=data/knowledge.db

# Ключ API для LLM (DeepSeek). Если пусто — бот работает без генерации (fallback-ответ)
LLM_API_KEY=

# Базовый URL LLM API (по умолчанию DeepSeek, OpenAI-совместимый)
LLM_BASE_URL=https://api.deepseek.com

# Модель LLM
LLM_MODEL=deepseek-chat
